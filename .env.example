# First image is used as the source for disk generation and install scripts.
BOOTC_IMAGE_REFS="ghcr.io/oci-native/archlinux-laptop"

# Optional explicit image used by install/build scripts.
BOOTC_LAPTOP_IMAGE_REF="ghcr.io/oci-native/archlinux-laptop"
BOOTC_LAPTOP_LOCAL_TAG="localhost/archlinux-laptop"

# GHCR: use a GitHub token with write:packages for build/push and
# read:packages for installing from a private image.
GHCR_USERNAME=
GHCR_TOKEN=

# Optional defaults.
BOOTC_DISK_SIZE=64G
BOOTC_USER=bupdlap
