# First image is used as the source for disk generation and install scripts.
BOOTC_IMAGE_REFS="ghcr.io/oci-native/archlinux"

# Optional explicit image used by install/build scripts.
BOOTC_PC_IMAGE_REF="ghcr.io/oci-native/archlinux"

# GHCR publishing requires a GitHub token with the `write:packages` scope.
# Pulling a private GHCR image requires `read:packages`.
GHCR_USERNAME=
GHCR_TOKEN=

# Optional defaults.
BOOTC_DISK_SIZE=32G
BOOTC_USER=bupd
