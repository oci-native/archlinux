# First image is used as the source for disk generation and install scripts.
BOOTC_IMAGE_REFS="ttl.sh/oci-native/archlinux"

# Optional explicit image used by install/build scripts.
BOOTC_LAPTOP_IMAGE_REF="ttl.sh/oci-native/archlinux"
BOOTC_LAPTOP_LOCAL_TAG="localhost/archlinux-laptop"

# ttl.sh needs no credentials. These are only needed if the image is later
# moved to GHCR.
GHCR_USERNAME=
GHCR_TOKEN=

# Optional defaults.
BOOTC_DISK_SIZE=32G
BOOTC_USER=bupd
