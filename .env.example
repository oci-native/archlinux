# First image is used as the source for the disk-image and switch tasks.
BOOTC_IMAGE_REFS="ghcr.io/oci-native/archlinux"

# Optional explicit image used by Taskfile workflows.
BOOTC_PC_IMAGE_REF="ghcr.io/oci-native/archlinux"

# Optional when Podman is already logged in to GHCR. Otherwise, publishing
# requires a GitHub token with `write:packages`; private pulls need `read:packages`.
GHCR_USERNAME=
GHCR_TOKEN=

# Optional defaults.
BOOTC_DISK_SIZE=32G
BOOTC_USER=bupd
