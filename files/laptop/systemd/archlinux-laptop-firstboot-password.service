[Unit]
Description=Initialize the local laptop user password
After=local-fs.target
Before=getty@tty1.service gdm.service
ConditionPathExists=!/var/lib/archlinux-laptop/user-password-initialized

[Service]
Type=oneshot
ExecStart=/usr/libexec/archlinux-laptop-initialize-password
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TimeoutStartSec=infinity

[Install]
WantedBy=graphical.target
